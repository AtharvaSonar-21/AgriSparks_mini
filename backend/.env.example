# Port for the Node.js Express server to listen on
PORT=5000

# MongoDB Connection URI (e.g., mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI=mongodb://localhost:27017/plant-disease

# Allowed CORS origin in production (comma-separated if multiple, e.g. https://your-app.onrender.com)
CORS_ORIGIN=http://localhost:5173

# Application Environment (development / production)
NODE_ENV=development
